PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=autos_colombia

# simulator = pasarela de práctica local (no cobra nada) · wompi =  (sandbox o producción)
PAYMENT_GATEWAY=simulator
# URL pública de tu app (a donde la pasarela devuelve al cliente). Con Wompi debe ser alcanzable por internet.
APP_BASE_URL=http://localhost:3000

# Solo si PAYMENT_GATEWAY=wompi (llaves en Wompi > Desarrolladores > Secretos). Nunca las subas a Git.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
